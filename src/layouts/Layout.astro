---
import '../styles/globals.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/fraunces/opsz.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import VisitTracker from '../components/VisitTracker.astro';
import LangSuggest from '../components/LangSuggest.astro';
import { SITE, OPERATOR, PARTNER } from '../site';
import { LOCALES, LOCALE_META, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { absoluteUrl } from '../lib/seo';

interface Props {
    locale: Locale;
    title: string;
    description: string;
    /** Path of this page in each language that has it (for hreflang and the language switcher). */
    alternates: Partial<Record<Locale, string>>;
    type?: 'website' | 'article';
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
    noindex?: boolean;
}

const { locale, title, description, alternates, type = 'website', jsonLd, noindex = false } = Astro.props;
const ui = t(locale);
const meta = LOCALE_META[locale];
const selfPath = alternates[locale] ?? '/';
const canonical = absoluteUrl(selfPath);
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;

const orgLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    logo: `${SITE.url}/brand/logo.png`,
    slogan: ui.brand.slogan,
    description: ui.brand.tagline,
    knowsAbout: ['Travel insurance', 'Trip cancellation insurance', 'Schengen visa insurance', 'Medical repatriation', 'Travel assistance'],
    parentOrganization: { '@type': 'Organization', name: OPERATOR.legalName, url: OPERATOR.groupUrl },
    address: { '@type': 'PostalAddress', streetAddress: OPERATOR.street, postalCode: OPERATOR.postalCode, addressLocality: OPERATOR.city, addressCountry: OPERATOR.countryCode }
};
const siteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: absoluteUrl(alternates[locale] ?? '/'),
    inLanguage: meta.htmlLang,
    publisher: { '@type': 'Organization', name: SITE.name }
};
const isHome = ['/', '/de', '/fr', '/es'].includes(selfPath);
const ldBlocks = [orgLd, ...(isHome ? [siteLd] : []), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang={meta.htmlLang}>
    <head>
        <!-- Google Consent Mode v2: everything denied by default; updated by the cookie banner (vy-consent) -->
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
            try {
                var vyc = JSON.parse(localStorage.getItem('vy-consent') || 'null');
                if (vyc && vyc.v === 1)
                    gtag('consent', 'update', {
                        analytics_storage: vyc.analytics ? 'granted' : 'denied',
                        ad_storage: vyc.marketing ? 'granted' : 'denied',
                        ad_user_data: vyc.marketing ? 'granted' : 'denied',
                        ad_personalization: vyc.marketing ? 'granted' : 'denied'
                    });
            } catch (e) {}
        </script>
        {
            gtmId && (
                <>
                    <script is:inline>dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});</script>
                    <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${gtmId}`} />
                </>
            )
        }
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        {LOCALES.filter((l) => alternates[l]).map((l) => <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={absoluteUrl(alternates[l]!)} />)}
        {alternates.en && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.en)} />}
        <link rel="icon" href="/favicon.ico" sizes="48x48" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="alternate" type="text/plain" title="Summary for language models" href="/llms.txt" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="theme-color" content="#0F4955" />

        <meta property="og:type" content={type} />
        <meta property="og:locale" content={meta.ogLocale} />
        {LOCALES.filter((l) => l !== locale && alternates[l]).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={`${SITE.url}/brand/og-${locale}.png`} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />

        {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    </head>
    <body class="flex min-h-screen flex-col" data-partner={PARTNER.name}>
        <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
            >{ui.meta.skip}</a
        >
        <LangSuggest locale={locale} alternates={alternates} />
        <Header locale={locale} alternates={alternates} />
        <main id="content" class="grow"><slot /></main>
        <Footer locale={locale} />
        <CookieBanner locale={locale} />
        <VisitTracker />
    </body>
</html>
