---
import Logo from './Logo.astro';
import { SITE, OPERATOR, PARTNER } from '../site';
import { t, fill } from '../i18n/ui';
import { pagePath, guidePath, type Locale } from '../i18n/routes';
import { guidesFor, guideSlug } from '../lib/content';

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const guides = (await guidesFor(locale)).slice(0, 6);
const year = new Date().getFullYear();
const values = { site: SITE.name, operator: OPERATOR.legalName, address: OPERATOR.address, partner: PARTNER.name, partnerLegal: PARTNER.legalName, orias: PARTNER.orias };
const complaints = { en: 'Complaints book (Portugal)', de: 'Beschwerdebuch (Portugal)', fr: 'Livre de réclamations (Portugal)', es: 'Libro de reclamaciones (Portugal)' }[locale];
---

<footer class="mt-24 bg-ink text-paper/80">
    <div class="container-vy grid gap-12 py-16 md:grid-cols-[1.4fr_1.3fr_1fr]">
        <div>
            <Logo inverted />
            <p class="mt-6 font-serif text-2xl italic text-paper">{ui.brand.slogan}</p>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-paper/70">{ui.brand.tagline}</p>
            <p class="mt-6 text-sm"><a class="font-semibold text-paper hover:text-peach" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>

        <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-peach">{ui.footer.guides}</p>
            <ul class="mt-4 space-y-2 text-sm">
                {
                    guides.map((g) => (
                        <li>
                            <a class="hover:text-peach" href={guidePath(locale, guideSlug(g))}>
                                {g.data.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-peach">{ui.footer.info}</p>
            <ul class="mt-4 space-y-2 text-sm">
                <li><a class="hover:text-peach" href={pagePath('compare', locale)}>{ui.footer.compare}</a></li>
                <li><a class="hover:text-peach" href={pagePath('about', locale)}>{ui.footer.about}</a></li>
                <li><a class="hover:text-peach" href={pagePath('terms', locale)}>{ui.footer.terms}</a></li>
                <li><a class="hover:text-peach" href={pagePath('privacy', locale)}>{ui.footer.privacy}</a></li>
                <li><a class="hover:text-peach" href={pagePath('cookies', locale)}>{ui.footer.cookies}</a></li>
                <li><a class="hover:text-peach" href={pagePath('notice', locale)}>{ui.footer.notice}</a></li>
                <li><button type="button" data-cookie-settings class="hover:text-peach">{ui.footer.cookieSettings}</button></li>
                <li><a class="hover:text-peach" href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener">{complaints}</a></li>
            </ul>
        </div>
    </div>

    <div class="border-t border-paper/10">
        <div class="container-vy py-8 text-xs leading-relaxed text-paper/55">
            <p>{fill(ui.footer.disclaimer, values)}</p>
            <p class="mt-4">© {year} {OPERATOR.legalName}. {ui.footer.rights}</p>
        </div>
    </div>
</footer>
