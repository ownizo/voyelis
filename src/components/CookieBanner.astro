---
// Cookie consent banner (GDPR / ePrivacy).
// Choice stored in localStorage "vy-consent" (12 months). Future statistics or marketing scripts must
// listen to the "vy:consent" event or read window.vyConsent before loading.
import { t } from '../i18n/ui';
import { pagePath, type Locale } from '../i18n/routes';

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale).cookie;
---


<div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-50 hidden p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] sm:p-6" role="dialog" aria-live="polite" aria-labelledby="cookie-title">
    <div class="mx-auto max-h-[85vh] max-w-4xl overflow-y-auto rounded-3xl border border-ink/10 bg-white p-5 shadow-[0_20px_60px_-20px_rgba(13,27,42,0.45)] sm:p-8">
        <div id="cookie-main">
            <h2 id="cookie-title" class="text-lg">{c.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                {c.text}
                <a href={pagePath('cookies', locale)} class="font-semibold text-lagoon-deep underline">{c.policy}</a>
            </p>
            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:justify-end">
                <button type="button" data-cc="customize" class="btn-ghost">{c.customize}</button>
                <button type="button" data-cc="reject" class="btn-primary">{c.reject}</button>
                <button type="button" data-cc="accept" class="btn-primary">{c.accept}</button>
            </div>
        </div>

        <div id="cookie-custom" class="hidden">
            <h2 class="text-lg">{c.prefs}</h2>
            <div class="mt-4 divide-y divide-ink/10 text-sm">
                <label class="flex items-start justify-between gap-6 py-3">
                    <span><strong class="block text-ink">{c.necessary}</strong><span class="text-ink-soft">{c.necessaryText}</span></span>
                    <input type="checkbox" checked disabled class="mt-1 h-5 w-5 accent-[#0E7C7B]" />
                </label>
                <label class="flex cursor-pointer items-start justify-between gap-6 py-3">
                    <span><strong class="block text-ink">{c.analytics}</strong><span class="text-ink-soft">{c.analyticsText}</span></span>
                    <input type="checkbox" id="cc-analytics" class="mt-1 h-5 w-5 accent-[#0E7C7B]" />
                </label>
                <label class="flex cursor-pointer items-start justify-between gap-6 py-3">
                    <span><strong class="block text-ink">{c.marketing}</strong><span class="text-ink-soft">{c.marketingText}</span></span>
                    <input type="checkbox" id="cc-marketing" class="mt-1 h-5 w-5 accent-[#0E7C7B]" />
                </label>
            </div>
            <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:justify-end">
                <button type="button" data-cc="reject" class="btn-ghost">{c.rejectAll}</button>
                <button type="button" data-cc="save" class="btn-primary">{c.save}</button>
            </div>
        </div>
    </div>
</div>

<script>
    type Consent = { v: 1; necessary: true; analytics: boolean; marketing: boolean; ts: string };
    const KEY = 'vy-consent';
    const MAX_AGE = 365 * 24 * 3600 * 1000;
    const banner = document.getElementById('cookie-banner')!;
    const main = document.getElementById('cookie-main')!;
    const custom = document.getElementById('cookie-custom')!;
    const analytics = document.getElementById('cc-analytics') as HTMLInputElement;
    const marketing = document.getElementById('cc-marketing') as HTMLInputElement;

    function read(): Consent | null {
        try {
            const c = JSON.parse(localStorage.getItem(KEY) ?? 'null') as Consent | null;
            if (!c || c.v !== 1 || Date.now() - Date.parse(c.ts) > MAX_AGE) return null;
            return c;
        } catch {
            return null;
        }
    }
    function apply(c: Consent) {
        (window as any).vyConsent = c;
        const g = (window as any).gtag;
        if (typeof g === 'function') {
            const m = c.marketing ? 'granted' : 'denied';
            g('consent', 'update', { analytics_storage: c.analytics ? 'granted' : 'denied', ad_storage: m, ad_user_data: m, ad_personalization: m });
        }
        window.dispatchEvent(new CustomEvent('vy:consent', { detail: c }));
    }
    function save(a: boolean, m: boolean) {
        const c: Consent = { v: 1, necessary: true, analytics: a, marketing: m, ts: new Date().toISOString() };
        try {
            localStorage.setItem(KEY, JSON.stringify(c));
        } catch {}
        apply(c);
        banner.classList.add('hidden');
    }
    function open(customize = false) {
        const c = read();
        analytics.checked = c?.analytics ?? false;
        marketing.checked = c?.marketing ?? false;
        main.classList.toggle('hidden', customize);
        custom.classList.toggle('hidden', !customize);
        banner.classList.remove('hidden');
    }

    banner.addEventListener('click', (e) => {
        const action = (e.target as HTMLElement).closest<HTMLElement>('[data-cc]')?.dataset.cc;
        if (action === 'accept') save(true, true);
        else if (action === 'reject') save(false, false);
        else if (action === 'save') save(analytics.checked, marketing.checked);
        else if (action === 'customize') open(true);
    });
    document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-cookie-settings]')) {
            e.preventDefault();
            open(true);
        }
    });

    const existing = read();
    if (existing) apply(existing);
    else open(false);
</script>
