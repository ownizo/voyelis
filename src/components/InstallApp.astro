---
// "Install the app" button. Shown only when the browser can install the site:
// Chrome / Edge / Android fire `beforeinstallprompt`; iPhone and iPad Safari get step-by-step instructions.
// Hidden when the site is already running as an installed app.
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/routes';

interface Props {
    locale: Locale;
    variant?: 'footer' | 'menu';
}
const { locale, variant = 'footer' } = Astro.props;
const p = t(locale).pwa;
---

<button
    type="button"
    data-install-app
    hidden
    class:list={[
        'items-center gap-2',
        variant === 'footer'
            ? 'mt-5 inline-flex rounded-full border border-paper/30 px-4 py-2.5 text-sm font-semibold text-paper hover:border-peach hover:text-peach'
            : 'btn-ghost mt-3 w-full'
    ]}
>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 19h14"></path></svg>
    {p.install}
</button>

<dialog data-ios-install class="m-auto w-[min(92vw,420px)] rounded-3xl p-0 backdrop:bg-ink/50">
    <div class="p-7">
        <h2 class="text-xl">{p.iosTitle}</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-ink-soft">
            {p.iosSteps.map((s) => <li>{s}</li>)}
        </ol>
        <form method="dialog"><button class="btn-primary mt-6 w-full">{p.close}</button></form>
    </div>
</dialog>

<script>
    const w = window as any;
    const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
    const ios = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const buttons = () => document.querySelectorAll<HTMLButtonElement>('[data-install-app]');
    const show = () => buttons().forEach((b) => (b.hidden = false));

    if (!w.__vyInstall) {
        w.__vyInstall = true;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            w.__vyPrompt = e;
            show();
        });
        window.addEventListener('appinstalled', () => buttons().forEach((b) => (b.hidden = true)));
        document.addEventListener('click', async (e) => {
            if (!(e.target as HTMLElement).closest('[data-install-app]')) return;
            if (w.__vyPrompt) {
                w.__vyPrompt.prompt();
                await w.__vyPrompt.userChoice;
                w.__vyPrompt = null;
                buttons().forEach((b) => (b.hidden = true));
            } else if (ios) {
                document.querySelector<HTMLDialogElement>('[data-ios-install]')?.showModal();
            }
        });
        if ('serviceWorker' in navigator && location.protocol === 'https:') {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
        }
    }
    if (!standalone && ios) show();
</script>
