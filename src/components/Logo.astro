---
// Voyelis logo: map-and-suitcase mark + wordmark (deep teal, as in the brand logo).
interface Props {
    inverted?: boolean;
    class?: string;
}
const { inverted = false, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
    <span class:list={['flex shrink-0 items-center justify-center rounded-full', inverted ? 'h-14 w-14 bg-paper p-1' : 'h-14 w-14']}>
        <img src="/brand/mark-160.png" alt="" width="160" height="160" class="h-full w-full object-contain" decoding="async" />
    </span>
    <span class:list={['text-[1.75rem] font-medium leading-none tracking-tight', inverted ? 'text-paper' : 'text-brand']}>Voyelis</span>
</span>
