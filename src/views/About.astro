---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { t, fill } from '../i18n/ui';
import { LOCALES, pagePath, type Locale } from '../i18n/routes';
import { SITE, OPERATOR, PARTNER } from '../site';

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const a = ui.about;
const alternates = Object.fromEntries(LOCALES.map((l) => [l, pagePath('about', l)]));
const values = { operator: OPERATOR.legalName, partner: PARTNER.name, partnerLegal: PARTNER.legalName, orias: PARTNER.orias };
---

<Layout locale={locale} title={a.title} description={a.description} alternates={alternates}>
    <PageHeader eyebrow={a.eyebrow} title={a.h1} accent={a.accent} intro={a.intro} />

    <section class="container-vy grid gap-14 lg:grid-cols-2">
        <div class="prose-vy">
            <p set:html={fill(a.p1, values)} />
            <p set:html={fill(a.p2, values)} />
            <p set:html={fill(a.p3, values)} />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
            {
                a.cards.map(([title, text]) => (
                    <div class="card">
                        <h3 class="text-base">{title}</h3>
                        <p class="mt-2 text-sm text-ink-soft">{text}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="container-vy mt-20 grid gap-5 md:grid-cols-2">
        <div class="rounded-3xl bg-mist p-8">
            <h2 class="text-2xl">{a.contactTitle}</h2>
            <p class="mt-3 text-ink-soft">{a.contactText}</p>
            <a href={`mailto:${SITE.email}`} class="btn-primary mt-6">{SITE.email}</a>
        </div>
        <div class="card">
            <h2 class="text-2xl">{a.companyTitle}</h2>
            <p class="mt-3 leading-relaxed text-ink-soft">
                {OPERATOR.legalName}<br />
                {OPERATOR.street}<br />
                {OPERATOR.postalCode} {OPERATOR.city}, {OPERATOR.country}
                {OPERATOR.taxId && <><br />NIPC / VAT {OPERATOR.taxId}</>}
            </p>
            <p class="mt-4 text-sm"><a class="font-semibold text-lagoon-deep underline" href={pagePath('notice', locale)}>{ui.footer.notice}</a></p>
        </div>
    </section>

    <CtaBanner locale={locale} />
</Layout>
