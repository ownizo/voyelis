---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { t } from '../i18n/ui';
import { LOCALES, pagePath, type Locale } from '../i18n/routes';
import { guidesFor } from '../lib/content';
import { faqLd } from '../lib/seo';

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const h = ui.home;
const guides = (await guidesFor(locale)).filter((g) => g.data.featured).slice(0, 3);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, pagePath('home', l)]));
const compare = pagePath('compare', locale);
---

<Layout locale={locale} title={ui.meta.homeTitle} description={ui.meta.homeDescription} alternates={alternates} jsonLd={faqLd(h.faqs.map(([q, a]) => ({ q, a })))}>
    <section class="horizon relative overflow-hidden">
        <div class="container-vy grid gap-10 pb-16 pt-10 sm:gap-12 sm:pb-20 sm:pt-20 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
            <div class="lg:sticky lg:top-28 lg:self-start">
                <span class="eyebrow">{h.eyebrow}</span>
                <h1 class="mt-6">
                    {h.title}<br /><span class="accent">{h.accent}</span>
                </h1>
                <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft">{h.intro}</p>
                <ul class="mt-8 space-y-3">
                    {
                        h.trust.map((item) => (
                            <li class="flex items-center gap-3 text-sm font-semibold">
                                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-lagoon text-white">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </span>
                                {item}
                            </li>
                        ))
                    }
                </ul>
                <div class="mt-10 hidden items-center gap-4 text-lagoon lg:flex" aria-hidden="true">
                    <span class="h-3 w-3 rounded-full border-2 border-lagoon"></span>
                    <span class="flight-path h-1 w-40"></span>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="rotate-90"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z"></path></svg>
                    <span class="flight-path h-1 w-16"></span>
                    <span class="h-3 w-3 rounded-full bg-coral"></span>
                </div>
            </div>
            <div id="compare">
                <h2 class="sr-only">{h.formTitle}</h2>
                <QuoteForm locale={locale} />
            </div>
        </div>
    </section>

    <section class="container-vy mt-8">
        <span class="eyebrow">{h.stepsEyebrow}</span>
        <h2 class="mt-5 max-w-2xl">{h.stepsTitle} <span class="accent">{h.stepsAccent}</span></h2>
        <ol class="mt-12 grid gap-5 md:grid-cols-3">
            {
                h.steps.map(([title, text], i) => (
                    <li class="card">
                        <span class="font-serif text-5xl italic text-lagoon/80">0{i + 1}</span>
                        <h3 class="mt-4 text-lg">{title}</h3>
                        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{text}</p>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="mt-24 bg-ink py-24 text-paper">
        <div class="container-vy">
            <span class="eyebrow !text-peach">{h.whyEyebrow}</span>
            <h2 class="mt-5 max-w-3xl text-paper">{h.whyTitle} <span class="accent !text-peach">{h.whyAccent}</span></h2>
            <div class="mt-14 grid gap-10 md:grid-cols-3">
                {
                    h.why.map(([title, text]) => (
                        <div class="border-t border-paper/15 pt-6">
                            <h3 class="text-lg text-paper">{title}</h3>
                            <p class="mt-3 text-sm leading-relaxed text-paper/70">{text}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="container-vy mt-24">
        <span class="eyebrow">{h.coversEyebrow}</span>
        <h2 class="mt-5 max-w-2xl">{h.coversTitle} <span class="accent">{h.coversAccent}</span></h2>
        <div class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-3">
            {
                h.covers.map(([title, text]) => (
                    <div class="bg-paper p-7">
                        <h3 class="text-base">{title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{text}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="container-vy mt-24">
        <span class="eyebrow">{h.typesEyebrow}</span>
        <h2 class="mt-5 max-w-2xl">{h.typesTitle} <span class="accent">{h.typesAccent}</span></h2>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                h.types.map(([title, text, purpose]) => (
                    <a href={`${compare}?purpose=${purpose}`} class="group flex items-center justify-between gap-6 rounded-3xl border border-ink/10 bg-white/70 p-6 transition hover:border-lagoon/40 hover:bg-white">
                        <span>
                            <span class="block font-bold group-hover:text-lagoon-deep">{title}</span>
                            <span class="mt-1 block text-sm text-ink-soft">{text}</span>
                        </span>
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-mist text-lagoon-deep transition group-hover:bg-lagoon group-hover:text-white">→</span>
                    </a>
                ))
            }
        </div>
    </section>

    {
        guides.length > 0 && (
            <section class="container-vy mt-24">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <span class="eyebrow">{h.guidesEyebrow}</span>
                        <h2 class="mt-5">
                            {h.guidesTitle} <span class="accent">{h.guidesAccent}</span>
                        </h2>
                    </div>
                    <a href={pagePath('guides', locale)} class="btn-ghost">
                        {h.guidesAll}
                    </a>
                </div>
                <div class="mt-10 grid gap-5 md:grid-cols-3">
                    {guides.map((p) => (
                        <ArticleCard post={p} />
                    ))}
                </div>
            </section>
        )
    }

    <section class="container-vy mt-24 max-w-4xl">
        <h2 class="text-3xl">{h.faqTitle}</h2>
        <div class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
            {
                h.faqs.map(([q, a]) => (
                    <details class="group py-5">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-bold">
                            {q}
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink/15 transition group-open:rotate-45">+</span>
                        </summary>
                        <p class="mt-3 leading-relaxed text-ink-soft">{a}</p>
                    </details>
                ))
            }
        </div>
    </section>

    <CtaBanner locale={locale} />
</Layout>
