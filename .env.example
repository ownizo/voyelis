# Set these in Netlify → Project configuration → Environment variables (never in the repository)

# Active provider: hellosafe (default) | none
INSURANCE_PROVIDER=hellosafe

# HelloSafe Atlas — API key (HelloSafe dashboard → Técnico → Chaves API)
ATLAS_KEY_ID=            # ak_test_… (sandbox) or ak_live_… (production)
ATLAS_SIGNING_SECRET=    # sk_… — shown only once
# Only "true" in Deploy Previews: allows the sandbox key (fictitious prices)
ATLAS_ALLOW_SANDBOX=
# Sales webhook secret (HelloSafe dashboard → Técnico → Webhooks)
ATLAS_WEBHOOK_SECRET=

# Internal notification of sales (Resend)
RESEND_API_KEY=
NOTIFY_FROM="Voyelis <notifications@voyelis.com>"
NOTIFY_TO=info@voyelis.com

# Optional: Google Tag Manager container (loaded in consent mode only if set)
PUBLIC_GTM_ID=
